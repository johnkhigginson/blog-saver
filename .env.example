# SQL Server connection string (used by Prisma CLI for migrations/push)
DATABASE_URL="sqlserver://localhost:1433;database=BlogSaver;user=sa;password=YourPassword;trustServerCertificate=true;encrypt=true"

# Individual DB connection params (used by the app via the mssql adapter)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=BlogSaver
DB_USER=sa
DB_PASSWORD=YourPassword

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=your_secret_here
AUTH_TRUST_HOST=true

# Public site URL — used for absolute links in SEO output (sitemap, RSS, Open
# Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postmark (optional) — sends an email to a blog owner when someone comments.
# Leave unset to disable comment notifications.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
